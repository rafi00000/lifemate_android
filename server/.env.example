# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Not needed for `npm run dev:memory`, which starts a local in-memory MongoDB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifemate?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Browser origins allowed to call the API (web build only), comma separated.
CORS_ORIGINS=http://localhost:8081

# Set to 1 when deployed behind one reverse proxy (Render, Railway, etc.).
TRUST_PROXY=0
